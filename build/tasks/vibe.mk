VIBE_TARGET_PACKAGE := $(PRODUCT_OUT)/Vibe-$(VIBE_VERSION).zip

SHA256 := prebuilts/build-tools/path/$(HOST_PREBUILT_TAG)/sha256sum

$(VIBE_TARGET_PACKAGE): $(INTERNAL_OTA_PACKAGE_TARGET)
	$(hide) ln -f $(INTERNAL_OTA_PACKAGE_TARGET) $(VIBE_TARGET_PACKAGE)
	$(hide) $(SHA256) $(VIBE_TARGET_PACKAGE) | sed "s|$(PRODUCT_OUT)/||" > $(VIBE_TARGET_PACKAGE).sha256sum
	@echo "Vibe Package Complete: $(VIBE_TARGET_PACKAGE)" >&2

.PHONY: vibe
vibe: $(VIBE_TARGET_PACKAGE) $(DEFAULT_GOAL)
